# macOS
.DS_Store

# Xcode (project is generated by XcodeGen from project.yml)
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
build/
# generated by XcodeGen from project.yml
App/Info.plist

# SwiftPM
.build/
.swiftpm/

# local mise overrides
mise.local.toml

# JetBrains
.idea/

# local output (mise run clean): builds, test runs, capture projects; with --all, captures (may hold
# private paths and hostnames; sanitized copies are the committed fixtures) and hang captures
.tmp/
# the old place for them; ignored until it is moved or deleted (its folders may be Paddock projects)
scratch/
